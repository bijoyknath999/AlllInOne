          android:pathData="M48,8 L81,27 L81,69 L48,88 L15,69 L15,27 Z" />

      <!-- Inner hexagon fill -->
      <path
          android:fillColor="#1A1A2E"
          android:pathData="M48,14 L77,31 L77,65 L48,82 L19,65 L19,31 Z" />

      <!-- Letter "A" (abstract triangular) -->
      <path
          android:fillColor="#E53935"
          android:pathData="M48,25 L63,62 L33,62 Z" />

      <!-- "A" crossbar cutout (white) -->
      <path
          android:fillColor="#1A1A2E"
          android:pathData="M40,50 L56,50 L58,56 L38,56 Z" />

      <!-- Small dot accent bottom-right -->
      <path
          android:fillColor="#FF6F60"
          android:pathData="M66,64 A4,4 0 1,1 66.001,64 Z" />
  </group>
</vector>
