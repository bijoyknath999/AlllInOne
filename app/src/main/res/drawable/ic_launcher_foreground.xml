<?xml version="1.0" encoding="utf-8"?>
<!-- Modern geometric "AIO" logo mark — hexagon with abstract "A" inside -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
  <group android:scaleX="0.65"
      android:scaleY="0.65"
      android:translateX="16.8"
      android:translateY="16.8">

      <!-- Outer hexagon glow (red) -->
      <path
          android:fillColor="#33E53935"
          android:pathData="M48,4 L84,24 L84,72 L48,92 L12,72 L12,24 Z" />

      <!-- Outer hexagon -->
      <path
          android:fillColor="#00000000"
          android:strokeColor="#E53935"
