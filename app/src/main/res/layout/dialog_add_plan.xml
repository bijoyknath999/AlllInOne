<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="22dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Study Goal"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Set a deadline, then check off chapters daily"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Scrollable body (keeps the dialog responsive on short screens) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:scrollbarThumbVertical="@color/divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp">

            <TextView style="@style/StudyFieldLabel" android:text="Subject" />

            <EditText
                android:id="@+id/et_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="e.g. Physics, Data Structures"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:padding="14dp"
                android:inputType="textCapWords"
                android:maxLines="1" />

            <TextView style="@style/StudyFieldLabel" android:text="Finish in" />

            <!-- Duration presets -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_presets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <EditText
                android:id="@+id/et_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:hint="30"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:padding="14dp"
                android:inputType="number"
                android:maxLines="1"
                android:drawablePadding="8dp" />

            <!-- Live deadline preview -->
            <TextView
                android:id="@+id/tv_deadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_deadline_pill"
                android:padding="12dp"
                android:text="🎯 Finish by —"
                android:textColor="@color/study_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView style="@style/StudyFieldLabel" android:text="Colour" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_colors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Reminder -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp">

                <CheckBox
                    android:id="@+id/cb_reminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:buttonTint="@color/study_accent"
                    android:text="Daily reminder"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_reminder_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginStart="8dp"
                    android:text="7:00 PM"
                    android:textColor="@color/study_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingVertical="8dp"
                    android:background="@drawable/bg_deadline_pill"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:paddingVertical="14dp"
            android:background="@drawable/bg_btn_ghost"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:gravity="center"
            android:text="Create Goal"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingVertical="14dp"
            android:background="@drawable/bg_study_button"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
