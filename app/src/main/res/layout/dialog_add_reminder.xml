<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Reminder"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TITLE"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Reminder title"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@drawable/bg_input_field"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:maxLines="1" />

        <!-- Message -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MESSAGE"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Message (optional)"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:background="@drawable/bg_input_field"
            android:padding="12dp"
            android:layout_marginBottom="20dp"
            android:maxLines="2" />

        <!-- Schedule type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCHEDULE"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <RadioGroup
            android:id="@+id/rg_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_once"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Specific date &amp; time"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                android:buttonTint="@color/color_primary" />

            <RadioButton
                android:id="@+id/rb_minutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Custom minutes"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                android:buttonTint="@color/color_primary" />

            <RadioButton
                android:id="@+id/rb_hourly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Every hour"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                android:buttonTint="@color/color_primary" />

            <RadioButton
                android:id="@+id/rb_daily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Every day"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                android:buttonTint="@color/color_primary"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_weekly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Every week"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                android:buttonTint="@color/color_primary" />

            <RadioButton
                android:id="@+id/rb_biweekly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Every 2 weeks"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                android:buttonTint="@color/color_primary" />

            <RadioButton
                android:id="@+id/rb_monthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Every month"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:paddingVertical="8dp"
                android:buttonTint="@color/color_primary" />
        </RadioGroup>

        <!-- Date + time pickers — Once only -->
        <LinearLayout
            android:id="@+id/ll_datetime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATE"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_date_once"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Date"
                    android:textColor="@color/color_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_input_field"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIME"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_time_once"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Time"
                    android:textColor="@color/color_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_input_field"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />
            </LinearLayout>
        </LinearLayout>

        <!-- Time of day — Daily / Weekly / Biweekly / Monthly -->
        <LinearLayout
            android:id="@+id/ll_time_recurring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTIFICATION TIME"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_time_recurring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="8:00 AM"
                android:textColor="@color/color_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />
        </LinearLayout>

        <!-- Custom minutes — Custom minutes only -->
        <EditText
            android:id="@+id/et_minutes"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Minutes (e.g. 30)"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:inputType="number"
            android:background="@drawable/bg_input_field"
            android:padding="10dp"
            android:visibility="gone" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="#22FFFFFF" />

        <!-- Image -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IMAGE (OPTIONAL)"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/btn_pick_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Image"
                android:textColor="@color/color_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tv_image_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="No image"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:ellipsize="middle"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/iv_img_remove"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_close_small"
                android:contentDescription="@null"
                android:alpha="0.5"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_image_preview"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="4dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            android:background="@drawable/bg_input_field"
            android:visibility="gone" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp"
            android:background="#22FFFFFF" />

        <!-- Sound + Vibrate -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOTIFICATION"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cb_sound"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sound"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:checked="true"
                android:buttonTint="@color/color_primary" />

            <CheckBox
                android:id="@+id/cb_vibrate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vibrate"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:checked="true"
                android:buttonTint="@color/color_primary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>