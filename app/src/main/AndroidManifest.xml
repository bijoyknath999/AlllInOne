<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for yt-dlp downloads -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Storage write needed on API 28 (Android 9) only -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    <!-- Read storage on API 28 for Files tab -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Foreground service for background downloads -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Foreground service for the always-on focus timer -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Notification permission (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact alarms for reminders -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Needed to reschedule alarms after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- APK install from DownloadManager -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AllInOne">

        <!-- Splash Screen — app entry point -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AllInOne.Splash"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Download Manager -->
        <activity
            android:name=".DownloadManagerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- YT Downloader Tool -->
        <activity
            android:name=".YtDownloaderActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- FB Downloader Tool -->
        <activity
            android:name=".FbDownloaderActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- In-app Facebook browser (login + video picking) -->
        <activity
            android:name=".FbBrowserActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Download Service (runs downloads in background) -->
        <service
            android:name=".downloader.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Expense Tracker -->
        <activity
            android:name=".ExpenseTrackerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Money Manager sub-screens -->
        <activity android:name=".expense.AccountsActivity"
            android:exported="false" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".expense.CategoriesActivity"
            android:exported="false" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".expense.LoansActivity"
            android:exported="false" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".expense.RecurringActivity"
            android:exported="false" android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".expense.ReportsActivity"
            android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".expense.SettingsActivity"
            android:exported="false" android:screenOrientation="portrait" />

        <!-- Recurring transactions: daily alarm + reschedule on boot -->
        <receiver
            android:name=".expense.RecurringReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Reminders -->
        <activity
            android:name=".ReminderActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Reminder alarm receiver -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- Reschedule reminders on device boot -->
        <receiver
            android:name=".reminder.ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Study Focus -->
        <activity
            android:name=".StudyFocusActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".StudyPlanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".FocusTimerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Study reminder alarm receiver -->
        <receiver
            android:name=".study.StudyReminderReceiver"
            android:exported="false" />

        <!-- Focus timer completion alarm (fires even when app is backgrounded) -->
        <receiver
            android:name=".study.FocusAlarmReceiver"
            android:exported="false" />

        <!-- Focus timer foreground service (keeps the countdown notification always visible) -->
        <service
            android:name=".study.FocusTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Pomodoro study focus timer countdown" />
        </service>

        <!-- Reschedule study reminders on device boot -->
        <receiver
            android:name=".study.StudyBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for APK update installs -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fileprovider_paths" />
        </provider>

    </application>

</manifest>
